---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MastRail from '../../components/MastRail.astro';

const series = (await getCollection('work'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const mediumLabel = (frames: { type: string }[], override?: string) => {
  if (override) return override;
  const hasFilm = frames.some((f) => f.type === 'film');
  const hasStill = frames.some((f) => f.type === 'still');
  return hasFilm && hasStill ? 'Stills & film' : hasFilm ? 'Film' : 'Stills';
};
---
<Base
  title="Work — kagiso.me"
  description="Selected bodies of work — photographs and films, edited as series. One eye, many frames."
  bg="var(--paper)"
  color="var(--ink)"
>
  <SiteNav active="work" variant="light" />
  <MastRail index={1} variant="light" />

  <div class="work-room">
    <div class="wrap">
      <header class="mast">
        <div class="mghost" aria-hidden="true">W</div>
        <div class="eyebrow kick" data-rise style="--d:.05s"><span class="tk"></span>Work — Stills &amp; Motion</div>
        <h1 data-rise style="--d:.12s">One eye,<br>many frames.</h1>
        <p class="dek" data-rise style="--d:.24s">Photographs and films, edited as series — each a body of work, in an order I chose.</p>
        <div class="mbase"></div>
      </header>
    </div>

    <div class="wrap plates">
      {series.map((s) => {
        const d = s.data;
        const label = mediumLabel(d.frames, d.mediumLabel);
        return (
          <a class="plate reveal" href={`/work/${s.id}`} aria-label={`Open ${d.title}`}>
            <div class="cover">
              <div class="ph dev" style={`aspect-ratio:${d.coverAspect}`}>
                {d.cover ? <img src={d.cover} alt={d.coverAlt} loading="lazy" decoding="async" /> : <span class="tag">{d.coverTag ?? 'Frames'}</span>}
              </div>
            </div>
            <div class="meta">
              <div class="no">No. {d.number}</div>
              <h2>{d.title}</h2>
              <div class="line">{d.years}{d.place ? ` · ${d.place}` : ''}</div>
              <div class="medium">{label} · {d.frames.length} frames</div>
              {d.teaser && <p class="teaser">{d.teaser}</p>}
              <span class="enter">Enter <span class="arw">→</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <SiteFooter variant="light" maxWidth={1280} note={'© 2026 · kagiso.me · <a href="https://www.instagram.com/">Instagram</a> · every frame shot &amp; owned'} />
</Base>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .mast { position: relative; padding: clamp(88px, 11vw, 148px) 0 40px; max-width: 920px; }
  .kick { display: inline-flex; align-items: center; gap: 11px; margin-bottom: 22px; color: var(--w-mut); }
  .kick .tk { width: 9px; height: 9px; background: var(--ember); }
  .mast h1 { font-family: var(--serif); font-weight: 440; font-size: clamp(3.25rem, 9vw, 132px); line-height: .9; letter-spacing: -.025em; color: var(--w-ink); }
  .mast .dek { font-family: var(--serif); font-style: italic; font-size: clamp(1.25rem, 2.6vw, 30px); line-height: 1.3; color: var(--w-mut); margin: 22px 0 0; max-width: 34ch; }
  .mast .kick, .mast h1, .mast .dek, .mast .mbase { position: relative; z-index: 1; }
  .mghost { position: absolute; z-index: 0; top: -16px; right: -1%; font-family: var(--serif); font-weight: 400;
    font-size: clamp(150px, 26vw, 320px); line-height: .72; color: var(--cream); pointer-events: none; user-select: none; }
  .mbase { height: 3px; width: 100%; margin-top: 44px; transform-origin: left;
    background: linear-gradient(90deg, var(--ember) 0, var(--ember) 30%, var(--w-line) 30%, var(--w-line) 100%); }
  :global(.anim) .mbase { transform: scaleX(0); animation: growx 1.3s cubic-bezier(.3, .7, .2, 1) forwards .6s; }
  @keyframes growx { to { transform: scaleX(1); } }

  .plates { display: flex; flex-direction: column; gap: clamp(80px, 10vw, 140px); padding: clamp(48px, 7vw, 96px) 0 40px; }
  .plate { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(28px, 4vw, 56px); align-items: start;
    border-top: 1px solid var(--w-line); padding-top: clamp(40px, 5vw, 64px); }
  .cover { grid-column: 1 / 8; }
  .meta { grid-column: 9 / 13; }
  .plate:nth-child(even) .cover { grid-column: 6 / 13; }
  .plate:nth-child(even) .meta { grid-column: 1 / 5; }

  .ph { position: relative; overflow: hidden; border: 1px solid var(--w-line); background: var(--cream); display: flex; }
  .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph .tag { position: absolute; inset: 0; margin: 0; border: 0; background: none; display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(14px, 1.6vw, 20px); letter-spacing: 0; text-transform: none; color: var(--w-faint); }
  .plate:hover .ph img { transform: scale(1.03); }
  .ph img { transition: transform .6s cubic-bezier(.2, .7, .2, 1); }

  .meta .no { font-family: var(--serif); font-weight: 440; font-size: 26px; color: var(--ember); line-height: 1; }
  .meta h2 { font-family: var(--serif); font-weight: 440; font-size: clamp(2rem, 4.2vw, 50px); line-height: 1; letter-spacing: -.015em; color: var(--w-ink); margin: 16px 0 0; }
  .meta .line { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--w-mut); margin-top: 20px; }
  .meta .medium { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--w-mut); margin-top: 6px; }
  .meta .teaser { font-family: var(--serif); font-style: italic; font-size: clamp(1.1rem, 1.6vw, 19px); color: var(--w-mut); margin: 20px 0 0; max-width: 26ch; }
  .meta .enter { display: inline-block; margin-top: 28px; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--w-ink); }
  .meta .enter .arw { color: var(--ember); display: inline-block; transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
  .plate:hover .enter .arw { transform: translateX(6px); }

  :global(.anim) .dev { filter: blur(16px); transform: scale(1.04); opacity: 0;
    transition: filter 1.3s cubic-bezier(.2, .7, .2, 1), transform 1.3s cubic-bezier(.2, .7, .2, 1), opacity 1s; }
  :global(.anim) .reveal.in .dev { filter: none; transform: none; opacity: 1; }

  @media (max-width: 1023px) { .wrap { --w-pad: 32px; } }
  @media (max-width: 767px) {
    .wrap { --w-pad: 22px; }
    .mast h1 { font-size: clamp(3rem, 15vw, 76px); }
    .plate, .plate:nth-child(even) .cover, .plate:nth-child(even) .meta { grid-column: 1 / 13; }
    .meta { margin-top: 20px; }
  }
</style>
