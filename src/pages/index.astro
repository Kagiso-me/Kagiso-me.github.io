---
import Base from '../layouts/Base.astro';
const ghUrl = 'https://github.com/Kagiso-me';
---
<Base title="Kagiso — Photography, Film, Cycling & The Lab" bg="var(--paper)" color="var(--ink)">
  <div class="page">
    <!-- ═══════════ HERO ═══════════ -->
    <header class="hero">
      <div class="hero-photo"></div>
      <div class="scrim"></div>
      <div class="grain"></div>
      <div class="ghost" aria-hidden="true">01</div>

      <div class="rail" data-rise style="--d:1s">
        <span class="v">Scroll</span><span class="ln"></span><span class="ix">01<span class="e"> / </span>05</span>
      </div>

      <div class="hero-inner">
        <div class="topbar">
          <a href="/" class="mark" data-rise style="--d:.05s">kagiso<span class="pt">.</span></a>
          <nav class="topnav" data-rise style="--d:.15s">
            <a href="/photography">Photography</a><a href="/film">Film</a><a href="/cycling">Cycling</a><a href="/lab">The Lab</a><a href="#contact">Contact</a>
          </nav>
        </div>

        <div class="hero-mid">
          <div class="index">
            <div class="lbl" data-rise style="--d:.55s">Contents</div>
            <a href="/photography" data-rise style="--d:.62s"><span class="n">01</span><span class="nm">Photography</span><span class="ds">the way light falls</span></a>
            <a href="/film" data-rise style="--d:.70s"><span class="n">02</span><span class="nm">Film</span><span class="ds">photography, with a timeline</span></a>
            <a href="/cycling" data-rise style="--d:.78s"><span class="n">03</span><span class="nm">Cycling</span><span class="ds">long roads, early light</span></a>
            <a href="/lab" data-rise style="--d:.86s"><span class="n">04</span><span class="nm">The Lab</span><span class="ds">the systems, run for real</span></a>
            <a href="#contact" data-rise style="--d:.94s"><span class="n">05</span><span class="nm">Contact</span><span class="ds">say hello</span></a>
          </div>

          <div class="headline">
            <span class="h-eye" data-rise style="--d:.3s"><span class="tk"></span>Kagiso — Johannesburg · <span class="is">Issue 01</span></span>
            <h1 data-rise>Outlast<span class="two">the moment.</span></h1>
            <span class="h-tag" data-rise style="--d:1.05s">pictures · films · cycling · the lab</span>
          </div>
        </div>

        <div class="hero-bottom">
          <div class="socials" data-rise style="--d:1.1s">
            <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
            <a href="#" aria-label="Vimeo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8l3-1 2 9c3-2 5-5 5-8 0-1-1-2-3-1M13 6c3-2 6-2 6 2 0 4-4 9-7 9"/></svg></a>
            <a href={ghUrl} aria-label="GitHub"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 19c-4 1.2-4-2-6-2m12 4v-3.5c0-1 .3-1.7-.5-2.4 2.5-.3 5-1.2 5-5.4 0-1.2-.4-2.1-1-2.9.1-.3.5-1.5-.1-3 0 0-1-.3-3.4 1.2a11.6 11.6 0 0 0-6 0C6 3.6 5 3.9 5 3.9c-.6 1.5-.2 2.7-.1 3-.7.8-1 1.7-1 2.9 0 4.2 2.5 5.1 5 5.4-.3.3-.5.8-.5 1.6V21"/></svg></a>
          </div>
          <div class="scrollcue" data-rise style="--d:1.1s">Scroll to explore
            <span class="dn"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M6 13l6 6 6-6"/></svg></span>
          </div>
        </div>
      </div>
      <div class="baseline"></div>
    </header>

    <!-- ═══════════ BODY ═══════════ -->
    <div class="wrap">
      <section class="breathe reveal">
        <p class="k">One eye, many crafts — the page breathes out of the dark and into the light.</p>
        <span class="m">Selected work · 2023—2026</span>
      </section>
    </div>

    <hr class="rule" />
    <div class="wrap">
      <section class="spread a reveal">
        <div class="snum" aria-hidden="true">01</div>
        <div class="txt">
          <div class="eyebrow"><span class="tk"></span>Photography</div>
          <h2>The way light falls when no one is performing.</h2>
          <p class="felt">Stills, mostly quiet. The archive I keep because a moment deserves better than a thumbnail.</p>
          <a href="/photography" class="go">See the frames →</a>
        </div>
        <div class="gal">
          <div class="ph"><span class="tag">Portrait / still</span></div>
          <div class="ph"><span class="tag">Still</span></div>
          <div class="ph"><span class="tag">Still</span></div>
        </div>
      </section>

      <hr class="rule" />

      <section class="spread b reveal">
        <div class="snum" aria-hidden="true">02</div>
        <div class="txt">
          <div class="eyebrow"><span class="tk"></span>Film</div>
          <h2>Photography, with a timeline.</h2>
          <p class="felt">The same eye for composition, the same obsession with the detail — moving now.</p>
          <a href="/film" class="go">Watch the reel →</a>
        </div>
        <div class="ph wide"><span class="tag">Film — poster frame · click to play</span></div>
      </section>

      <hr class="rule" />

      <section class="spread a reveal">
        <div class="snum" aria-hidden="true">03</div>
        <div class="txt">
          <div class="eyebrow"><span class="tk"></span>Cycling</div>
          <h2>Long roads, early light, a clear head.</h2>
          <p class="felt">Where the thinking gets done. The routes, the climbs, and the frames I stop to take.</p>
          <a href="/cycling" class="go">Ride along →</a>
        </div>
        <div class="ph"><span class="tag">Cycling photograph — road / route</span></div>
      </section>

      <hr class="rule" />
    </div>

    <section class="lab reveal">
      <div class="wrap">
        <div class="snum" aria-hidden="true">04</div>
        <div class="inner">
          <div class="eyebrow">The Lab</div>
          <h2>I also run the systems, not just talk about them.</h2>
          <p>A real three-node Kubernetes cluster on hardware I own — GitOps, identity, storage, backups, observability, run with production discipline. The small door at the end of the hall, and it stays that way on purpose.</p>
          <div class="proof">
            <div class="fig"><div class="v">312<span style="color:var(--ember)">d</span></div><div class="k">longest unbroken uptime</div></div>
            <div class="links">
              <a href="/lab"><span class="arw">→</span> &nbsp;Selected work — the repo &amp; write-ups</a>
              <a href="/lab"><span class="arw">→</span> &nbsp;What it is, and why · the essay</a>
              <a href="/blog"><span class="arw">→</span> &nbsp;The journal — incidents &amp; decisions</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap"><div class="q reveal">
        <p>Different crafts, <span class="e">one hand.</span> The eye that frames a photograph is the same one that keeps a system honest.</p>
        <div class="by">Kagiso</div>
      </div></div>
    </section>

    <footer id="contact">
      <div class="wrap">
        <div class="grid reveal">
          <div class="txt">
            <div class="eyebrow">Contact</div>
            <h2>Say hello.</h2>
            <a href="mailto:hello@kagiso.me" class="mailto">hello@kagiso.me</a>
          </div>
          <div class="cols">
            <div class="col"><div class="k">Based</div><div class="v">Johannesburg,<br>South Africa</div></div>
            <div class="col"><div class="k">Elsewhere</div><div class="v"><a href="#">Instagram</a><br><a href="#">Vimeo</a><br><a href={ghUrl}>GitHub</a></div></div>
          </div>
        </div>
        <div class="colo">
          <span class="sign">kagiso<span class="pt">.</span></span>
          <span>© 2026 · Set in Cormorant Garamond &amp; Manrope · self-hosted on kagiso.me</span>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  .page {
    --hero: #100D0A; --hero-2: #0B0908; --hero-tx: #F4F0E8; --hero-mut: #AAA093; --hero-fnt: #6E655A;
    --hero-line: rgba(244, 240, 232, .16); --ember-lit: #D5743E;
  }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 48px; }

  /* ═══════════ MAGAZINE-COVER HERO ═══════════ */
  .hero { position: relative; height: 100vh; min-height: 720px; background: var(--hero); overflow: hidden; color: var(--hero-tx); }
  .hero-photo { position: absolute; inset: 0; z-index: 0; transform: scale(1.05);
    background:
      radial-gradient(42% 56% at 63% 48%, rgba(201, 155, 108, .32) 0%, rgba(120, 92, 64, .10) 38%, transparent 66%),
      radial-gradient(28% 78% at 99% 40%, rgba(213, 140, 90, .24) 0%, transparent 55%),
      radial-gradient(60% 66% at 50% 6%, rgba(0, 0, 0, .5), transparent 60%),
      radial-gradient(130% 100% at 16% 94%, rgba(6, 5, 4, .8), transparent 58%),
      linear-gradient(180deg, #17120e 0%, #0b0807 100%); }
  .hero-photo::before { content: ""; position: absolute; inset: 0;
    background: radial-gradient(25% 46% at 61% 60%, rgba(0, 0, 0, .36) 0%, transparent 72%); }
  .scrim { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(8, 6, 5, .55) 0%, transparent 42%),
      linear-gradient(0deg, rgba(8, 6, 5, .62) 0%, transparent 32%),
      linear-gradient(270deg, rgba(8, 6, 5, .42) 0%, transparent 30%); }
  .grain { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: .05;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>"); }
  :global(.anim) .hero-photo { animation: develop 2s cubic-bezier(.22, .61, .25, 1) both; }
  @keyframes develop { from { filter: blur(22px) brightness(.32) saturate(.7); transform: scale(1.15); } to { filter: blur(0) brightness(1) saturate(1); transform: scale(1.05); } }

  .ghost { position: absolute; z-index: 3; top: 2%; right: -2.5%; font-family: var(--serif); font-weight: 500;
    font-size: clamp(200px, 40vw, 540px); line-height: .72; color: transparent;
    -webkit-text-stroke: 1px rgba(244, 240, 232, .15); pointer-events: none; user-select: none; }

  .hero-inner { position: relative; z-index: 5; height: 100%; max-width: 1320px; margin: 0 auto;
    padding: 26px 56px 22px; display: flex; flex-direction: column; }
  .topbar { display: flex; align-items: center; justify-content: space-between; }
  .mark { font-family: var(--serif); font-weight: 500; font-size: 28px; letter-spacing: -.012em; }
  .mark .pt { color: var(--ember-lit); }
  .topnav { display: flex; gap: 30px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--hero-mut); }
  .topnav a:hover { color: var(--hero-tx); }

  .hero-mid { position: relative; flex: 1; }

  .index { position: absolute; right: 0; top: 12%; width: 300px; z-index: 6; }
  .index .lbl { font-size: 11px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--hero-fnt);
    display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .index .lbl::after { content: ""; flex: 1; height: 1px; background: var(--hero-line); }
  .index a { display: grid; grid-template-columns: auto 1fr; gap: 0 14px; align-items: baseline;
    padding: 13px 0; border-top: 1px solid var(--hero-line); transition: padding-left .25s ease; }
  .index a:first-of-type { border-top: 0; }
  .index .n { font-family: var(--serif); font-size: 22px; color: var(--ember-lit); grid-row: span 2; }
  .index .nm { font-family: var(--serif); font-size: 24px; color: var(--hero-tx); line-height: 1; }
  .index .ds { font-size: 11.5px; color: var(--hero-mut); letter-spacing: .02em; margin-top: 3px; }
  .index a:hover { padding-left: 8px; }
  .index a:hover .nm { color: var(--ember-lit); }

  .headline { position: absolute; left: 0; bottom: 4%; z-index: 6; max-width: 66%; }
  .h-eye { display: inline-flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 600; letter-spacing: .22em;
    text-transform: uppercase; color: var(--hero-mut); margin-bottom: 18px; }
  .h-eye .is { color: var(--ember-lit); }
  .h-eye .tk { width: 26px; height: 1px; background: var(--ember-lit); }
  .headline h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(3.4rem, 11.5vw, 168px);
    line-height: .84; letter-spacing: -.03em; color: var(--hero-tx); }
  .headline h1 .two { display: block; font-style: italic; font-weight: 400; margin-left: .14em; color: #EFE7DA; }
  .h-tag { margin-top: 24px; display: inline-block; font-family: var(--serif); font-style: italic;
    font-size: clamp(1rem, 2vw, 22px); color: var(--hero-tx); border: 1px solid var(--ember-lit);
    border-left-width: 3px; padding: 8px 18px; }

  .rail { position: absolute; left: 22px; top: 50%; transform: translateY(-50%); z-index: 6;
    display: flex; flex-direction: column; align-items: center; gap: 14px; color: var(--hero-mut); }
  .rail .v { writing-mode: vertical-rl; font-size: 11px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; }
  .rail .ln { width: 1px; height: 60px; background: var(--hero-line); }
  .rail .ix { font-family: var(--serif); font-size: 14px; }
  .rail .ix .e { color: var(--ember-lit); }

  .hero-bottom { position: relative; z-index: 6; display: flex; align-items: center; justify-content: space-between; }
  .socials { display: flex; gap: 18px; color: var(--hero-mut); }
  .socials a:hover { color: var(--hero-tx); }
  .socials svg { width: 17px; height: 17px; display: block; }
  .scrollcue { display: inline-flex; align-items: center; gap: 12px; font-size: 11px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--hero-mut); }
  .scrollcue .dn { width: 34px; height: 34px; border: 1px solid var(--hero-line); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--ember-lit); }
  .baseline { position: absolute; left: 0; bottom: 0; z-index: 5; height: 3px; width: 100%; transform-origin: left;
    background: linear-gradient(90deg, var(--ember-lit) 0%, var(--ember-lit) 30%, var(--hero-line) 30%, var(--hero-line) 100%); }
  :global(.anim) .headline h1[data-rise] { transform: translateY(30px); filter: blur(14px); animation: heroRise 1.5s cubic-bezier(.2, .7, .2, 1) both; animation-delay: .5s; }
  @keyframes heroRise { to { opacity: 1; transform: none; filter: blur(0); } }
  :global(.anim) .ghost { opacity: 0; animation: ghostin 1.6s ease both .3s; }
  @keyframes ghostin { to { opacity: 1; } }
  :global(.anim) .baseline { transform: scaleX(0); animation: growx 1.3s cubic-bezier(.3, .7, .2, 1) forwards .7s; }
  @keyframes growx { to { transform: scaleX(1); } }

  /* ═══════════ WARM-LIGHT EDITORIAL BODY ═══════════ */
  .breathe { padding: 78px 0 4px; display: flex; align-items: baseline; gap: 22px; }
  .breathe .k { font-family: var(--serif); font-style: italic; font-size: clamp(1.3rem, 3vw, 30px); color: var(--ink); max-width: 24ch; }
  .breathe .m { margin-left: auto; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); white-space: nowrap; }
  .ph { position: relative; overflow: hidden; background: repeating-linear-gradient(135deg, #EFEAE0 0 22px, #F4F0E8 22px 44px); border: 1px solid var(--stone); display: flex; align-items: flex-end; }
  .ph .tag { margin: 14px; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); background: var(--paper); border: 1px solid var(--stone); padding: 5px 9px; }
  .spread { display: grid; gap: 56px; align-items: center; padding: 88px 0; position: relative; }
  .spread.a { grid-template-columns: 1fr 1.2fr; }
  .spread.b { grid-template-columns: 1.2fr 1fr; }
  .spread.b .txt { order: 2; }
  .snum { position: absolute; top: 44px; font-family: var(--serif); font-weight: 500; font-size: clamp(90px, 13vw, 200px); line-height: .7; color: var(--cream); z-index: 0; pointer-events: none; }
  .spread.a .snum { left: -8px; }
  .spread.b .snum { right: -8px; }
  .txt { position: relative; z-index: 1; }
  .spread .eyebrow { margin-bottom: 18px; display: inline-flex; align-items: center; gap: 10px; }
  .spread .eyebrow .tk { width: 8px; height: 8px; background: var(--ember); }
  .spread h2 { font-size: clamp(2rem, 4.4vw, 54px); max-width: 14ch; }
  .spread .felt { font-family: var(--serif); font-style: italic; font-size: 23px; color: var(--ink-soft); margin: 18px 0 0; max-width: 34ch; }
  .spread .go { display: inline-block; margin-top: 26px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; border-bottom: 2px solid var(--ember); padding-bottom: 3px; }
  .spread .ph { aspect-ratio: 4/5; min-height: 440px; }
  .spread .ph.wide { aspect-ratio: 16/10; min-height: 360px; }
  .gal { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; }
  .gal .ph { min-height: 0; }
  .gal .ph:first-child { grid-row: span 2; }

  .lab { padding: 96px 0; border-top: 1px solid var(--stone); position: relative; }
  .lab .snum { top: 64px; right: -8px; color: var(--cream); }
  .lab .inner { max-width: 760px; position: relative; z-index: 1; }
  .lab .eyebrow { margin-bottom: 20px; }
  .lab h2 { font-size: clamp(1.8rem, 4vw, 42px); max-width: 20ch; }
  .lab p { color: var(--ink-soft); margin: 20px 0 0; max-width: 58ch; }
  .lab .proof { margin-top: 38px; display: flex; gap: 52px; flex-wrap: wrap; padding-top: 30px; border-top: 1px solid var(--stone); }
  .lab .fig .v { font-family: var(--serif); font-size: 44px; line-height: 1; }
  .lab .fig .k { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); margin-top: 8px; }
  .lab .links { display: flex; flex-direction: column; gap: 10px; }
  .lab .links a { font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .lab .links a .arw { color: var(--ember); }
  .lab .links a:hover { color: var(--ember); }

  .band { background: var(--hero); color: var(--hero-tx); padding: 104px 0; }
  .band .q { max-width: 960px; margin: 0 auto; text-align: center; }
  .band .q p { font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 50px); line-height: 1.16; font-weight: 500; letter-spacing: -.01em; }
  .band .q p .e { color: var(--ember-lit); font-style: italic; }
  .band .q .by { margin-top: 24px; font-size: 12px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--hero-mut); }

  footer { padding: 100px 0 72px; }
  footer .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: end; }
  footer .eyebrow { margin-bottom: 20px; }
  footer h2 { font-size: clamp(2.4rem, 6vw, 58px); }
  footer .mailto { display: inline-block; margin-top: 22px; font-family: var(--serif); font-size: 30px; border-bottom: 1px solid var(--ink); padding-bottom: 4px; }
  footer .col .k { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); }
  footer .col .v { margin-top: 6px; }
  footer .cols { display: flex; gap: 52px; }
  footer .colo { margin-top: 60px; padding-top: 26px; border-top: 1px solid var(--stone); display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--ink-soft); }
  footer .colo .sign { font-family: var(--serif); font-size: 24px; color: var(--ink); letter-spacing: -.012em; }
  footer .colo .sign .pt { color: var(--ember); }

  @media (max-width: 960px) {
    .wrap, .hero-inner { padding-left: 24px; padding-right: 24px; }
    .topnav, .rail, .ghost { display: none; }
    .hero { height: auto; min-height: 100vh; }
    .hero-mid { display: flex; flex-direction: column; justify-content: flex-end; padding-top: 40px; }
    .index { position: static; width: auto; margin-bottom: 40px; order: 2; }
    .headline { position: static; max-width: none; order: 1; margin-bottom: 36px; }
    .headline h1 { font-size: clamp(3rem, 15vw, 84px); }
    .spread.a, .spread.b { grid-template-columns: 1fr; gap: 36px; padding: 60px 0; }
    .spread.b .txt { order: 0; }
    footer .grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('anim')) return;
    var inner = document.querySelector('.hero-inner'), photo = document.querySelector('.hero-photo'), ghost = document.querySelector('.ghost'), t = false;
    window.addEventListener('scroll', function () {
      if (t) return; t = true;
      requestAnimationFrame(function () {
        var y = window.scrollY || 0;
        if (y < window.innerHeight) {
          inner.style.transform = 'translateY(' + (y * 0.14) + 'px)';
          inner.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.82)));
          if (ghost) ghost.style.transform = 'translateY(' + (y * -0.06) + 'px)';
          photo.style.filter = 'brightness(' + Math.max(.5, 1 - y / (window.innerHeight * 1.4)) + ')';
        }
        t = false;
      });
    }, { passive: true });
  })();
</script>
