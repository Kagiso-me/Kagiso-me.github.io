---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
---
<Base title="Not found — kagiso.me" bg="var(--paper)" color="var(--ink)">
  <SiteNav variant="light" />
  <main class="four">
    <div class="eyebrow"><span class="tk"></span>Error 404</div>
    <h1>Lost the thread.</h1>
    <p>The page you're after isn't here — moved, renamed, or never was.</p>
    <a class="go" href="/">← Back to the cover</a>
  </main>
</Base>

<style>
  .four { max-width: 720px; margin: 0 auto; padding: 20vh 44px 24vh; }
  .eyebrow { display: inline-flex; align-items: center; gap: 11px; font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-soft); }
  .eyebrow .tk { width: 9px; height: 9px; background: var(--ember); }
  h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(3rem, 9vw, 108px); line-height: .92; letter-spacing: -.02em; margin: 22px 0 0; }
  p { color: var(--ink-soft); font-size: 19px; margin: 18px 0 0; max-width: 46ch; }
  .go { display: inline-block; margin-top: 30px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; border-bottom: 2px solid var(--ember); padding-bottom: 3px; }
  @media (max-width: 860px) { .four { padding-left: 22px; padding-right: 22px; } }
</style>
