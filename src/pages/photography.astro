---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MastRail from '../components/MastRail.astro';

const frames = (await getCollection('photography')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Photography — kagiso.me"
  description="Selected stills — the way light falls when no one is performing. Shot and owned by Kagiso."
  bg="#151210"
  color="#F3EFE7"
>
  <SiteNav active="photography" variant="dark" />
  <MastRail index={1} variant="dark" />

  <div class="wrap">
    <header class="mast">
      <div class="mghost" aria-hidden="true">01</div>
      <div class="eyebrow" data-rise style="--d:.05s"><span class="tk"></span><span class="n">01</span> — Photography</div>
      <h1 data-rise style="--d:.12s">Frames.</h1>
      <p class="sub" data-rise style="--d:.24s">The way light falls when no one is performing.</p>
      <div class="meta" data-rise style="--d:.34s">Selected stills · 2023—2026</div>
      <div class="mbase"></div>
    </header>
  </div>

  <div class="frames">
    {frames.map((f) => {
      const d = f.data;
      const meta = d.place ? <>{d.place} · <span class="e">{d.year}</span></> : d.year;
      if (d.kind === 'fullbleed') {
        return (
          <div class="frame fullbleed">
            <div class="ph dev" style={`min-height:${d.minvh ?? 54}vh`}>
              {d.image ? <img src={d.image} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tag}</span>}
            </div>
            <div class="cap"><span class="t">{d.title}</span><span class="m">{meta}</span></div>
          </div>
        );
      }
      if (d.kind === 'single') {
        return (
          <div class="wrap"><div class="frame single">
            <div class="ph dev">{d.image ? <img src={d.image} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tag}</span>}</div>
            <div class="cap"><span class="t">{d.title}</span><span class="m">{meta}</span></div>
          </div></div>
        );
      }
      if (d.kind === 'diptych') {
        return (
          <>
            <div class="wrap"><div class="divnum">{String(d.order).padStart(2, '0')}</div></div>
            <div class="wrap"><div class="frame diptych">
              <div>
                <div class="ph dev">{d.image ? <img src={d.image} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tag}</span>}</div>
                <div class="cap"><span class="t">{d.title}</span><span class="m">{d.year}</span></div>
              </div>
              <div>
                <div class="ph dev">{d.imageB ? <img src={d.imageB} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tagB}</span>}</div>
                <div class="cap"><span class="t">{d.titleB}</span><span class="m">{d.yearB}</span></div>
              </div>
            </div></div>
          </>
        );
      }
      if (d.kind === 'offset') {
        return (
          <div class="wrap"><div class:list={['frame', 'offset', d.side]}>
            <div class="ph dev">{d.image ? <img src={d.image} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tag}</span>}</div>
            <div class="cap"><span class="t">{d.title}</span><span class="m">{meta}</span></div>
          </div></div>
        );
      }
      return (
        <div class="wrap"><div class="frame wide">
          <div class="ph dev">{d.image ? <img src={d.image} alt={d.alt} loading="lazy" decoding="async" /> : <span class="tag">{d.tag}</span>}</div>
          <div class="cap"><span class="t">{d.title}</span><span class="m">{meta}</span></div>
        </div></div>
      );
    })}
  </div>

  <SiteFooter variant="dark" maxWidth={1280} note={'© 2026 · kagiso.me · <a href="#">Instagram</a> · every frame shot &amp; owned'} />
</Base>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .mast { position: relative; padding: 96px 0 40px; max-width: 900px; }
  .mast .eyebrow { margin-bottom: 22px; display: inline-flex; align-items: center; gap: 11px; }
  .mast .eyebrow .tk { width: 9px; height: 9px; background: var(--ember-lit, #D5743E); }
  .mast .eyebrow .n { color: var(--ember-lit, #D5743E); }
  .mast h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(3.4rem, 10vw, 132px); line-height: .92; letter-spacing: -.02em; margin: 0; }
  .mast .sub { font-family: var(--serif); font-style: italic; font-size: clamp(1.2rem, 2.6vw, 28px); color: #A79F92; margin: 22px 0 0; max-width: 34ch; }
  .mast .meta { margin-top: 30px; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: #6E665B; }
  .mast .eyebrow, .mast h1, .mast .sub, .mast .meta, .mast .mbase { position: relative; z-index: 1; }
  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: #A79F92; }
  .mghost { position: absolute; z-index: 0; top: -16px; right: -1%; font-family: var(--serif); font-weight: 500;
    font-size: clamp(150px, 26vw, 320px); line-height: .72; color: transparent;
    -webkit-text-stroke: 1px rgba(243, 239, 231, .13); pointer-events: none; user-select: none; }
  .mbase { height: 3px; width: 100%; margin-top: 44px; transform-origin: left;
    background: linear-gradient(90deg, #D5743E 0, #D5743E 30%, #302A22 30%, #302A22 100%); }
  :global(.anim) .mbase { transform: scaleX(0); animation: growx 1.3s cubic-bezier(.3, .7, .2, 1) forwards .6s; }
  @keyframes growx { to { transform: scaleX(1); } }

  .frames { padding: 20px 0 40px; display: flex; flex-direction: column; gap: 120px; }
  .frame { position: relative; }
  .ph { position: relative; overflow: hidden; background: radial-gradient(120% 120% at 40% 30%, #2a2119 0%, #171310 55%, #0e0b09 100%); border: 1px solid #302A22; }
  .ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph .tag { position: absolute; bottom: 14px; left: 14px; font-size: 10.5px; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: #A79F92; background: rgba(15, 13, 11, .72); border: 1px solid #302A22; padding: 5px 9px; }
  .cap { margin-top: 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .cap .t { font-family: var(--serif); font-style: italic; font-size: 22px; color: #F3EFE7; }
  .cap .m { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: #6E665B; }
  .cap .m .e { color: #D5743E; }
  .fullbleed { width: 100vw; margin-left: calc(50% - 50vw); }
  .fullbleed .ph { aspect-ratio: 21/9; border-left: 0; border-right: 0; }
  .fullbleed .cap { max-width: 1280px; margin-left: auto; margin-right: auto; padding: 18px 48px 0; }
  .single { max-width: 560px; margin: 0 auto; }
  .single .ph { aspect-ratio: 4/5; }
  .wide .ph { aspect-ratio: 16/9; }
  .diptych { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .diptych .ph { aspect-ratio: 3/4; }
  .offset { max-width: 760px; }
  .offset.right { margin-left: auto; }
  .offset .ph { aspect-ratio: 5/4; }
  .divnum { font-family: var(--serif); font-size: clamp(4rem, 12vw, 150px); color: #302A22; line-height: .8; text-align: center; padding: 24px 0; }

  :global(.anim) .dev { filter: blur(16px) brightness(.7); transform: scale(1.05); opacity: 0;
    transition: filter 1.3s cubic-bezier(.2, .7, .2, 1), transform 1.3s cubic-bezier(.2, .7, .2, 1), opacity 1s; }
  :global(.anim) .dev.in { filter: none; transform: none; opacity: 1; }

  @media (max-width: 820px) { .wrap { padding-left: 22px; padding-right: 22px; } .frames { gap: 72px; } .diptych { grid-template-columns: 1fr; } }
</style>
