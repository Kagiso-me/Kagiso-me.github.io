---
import Base from '../layouts/Base.astro';
---
<Base title="Kagiso — Photographer, Filmmaker & Cyclist" bg="var(--paper)" color="var(--ink)">
  <div class="page">
    <!-- ═══════════ BOLD PORTRAIT COVER ═══════════ -->
    <header class="hero">
      <div class="hero-top">
        <a href="/" class="mark" data-rise style="--d:.05s">kagiso<span class="pt">.</span></a>
        <nav class="hero-nav" data-rise style="--d:.14s">
          <a href="/stills-and-motion">Stills &amp; Motion</a><a href="/cycling">Cycling</a><a href="#contact">Contact</a>
        </nav>
      </div>

      <div class="hero-type">
        <span class="idx" data-rise style="--d:.5s">01</span>
        <span class="ghost" aria-hidden="true">Kagiso</span>
        <h1 class="name" data-rise style="--d:.12s">Kagiso</h1>
        <div class="type-foot" data-rise style="--d:.3s">
          <span class="sub">Photographer · Filmmaker · Cyclist</span>
          <span class="scrollcue">Scroll <span class="dn" aria-hidden="true">↓</span></span>
        </div>
      </div>

      <div class="hero-portrait">
        <div class="ph dev"><span class="tag">Portrait</span></div>
      </div>

      <span class="side" aria-hidden="true">Johannesburg · Est. 2024</span>
      <div class="baseline"></div>
    </header>

    <!-- ═══════════ BODY ═══════════ -->
    <div class="wrap">
      <section class="breathe reveal">
        <p class="k">One eye, many crafts — the page breathes out of the dark and into the light.</p>
        <span class="m">Selected work · 2023—2026</span>
      </section>
    </div>

    <hr class="rule" />
    <div class="wrap">
      <section class="spread a reveal">
        <div class="snum" aria-hidden="true">01</div>
        <div class="txt">
          <div class="eyebrow"><span class="tk"></span>Stills &amp; Motion</div>
          <h2>One eye — stills and motion, edited as series.</h2>
          <p class="felt">Photographs and films kept as bodies of work, not a feed. The archive I keep because a moment deserves better than a thumbnail.</p>
          <a href="/stills-and-motion" class="go">See the series →</a>
        </div>
        <div class="gal">
          <div class="ph"><span class="tag">Still</span></div>
          <div class="ph"><span class="tag">Still</span></div>
          <div class="ph"><span class="tag">Film — poster</span></div>
        </div>
      </section>

      <hr class="rule" />

      <section class="spread a reveal">
        <div class="snum" aria-hidden="true">02</div>
        <div class="txt">
          <div class="eyebrow"><span class="tk"></span>Cycling</div>
          <h2>Long roads, early light, a clear head.</h2>
          <p class="felt">Where the thinking gets done. The routes, the climbs, and the frames I stop to take.</p>
          <a href="/cycling" class="go">Ride along →</a>
        </div>
        <div class="ph"><span class="tag">Cycling photograph — road / route</span></div>
      </section>

      <hr class="rule" />
    </div>

    <section class="band">
      <div class="wrap"><div class="q reveal">
        <p>Different crafts, <span class="e">one hand.</span> The eye that frames a photograph is the same one that reads a road at first light.</p>
        <div class="by">Kagiso</div>
      </div></div>
    </section>

    <footer id="contact">
      <div class="wrap">
        <div class="grid reveal">
          <div class="txt">
            <div class="eyebrow">Contact</div>
            <h2>Say hello.</h2>
            <a href="mailto:hello@kagiso.me" class="mailto">hello@kagiso.me</a>
          </div>
          <div class="cols">
            <div class="col"><div class="k">Based</div><div class="v">Johannesburg,<br>South Africa</div></div>
            <div class="col"><div class="k">Elsewhere</div><div class="v"><a href="https://www.instagram.com/">Instagram</a><br><a href="https://vimeo.com/">Vimeo</a><br><a href="https://www.strava.com/">Strava</a></div></div>
          </div>
        </div>
        <div class="colo">
          <span class="sign">kagiso<span class="pt">.</span></span>
          <span>© 2026 · Set in Fraunces &amp; Manrope · kagiso.me</span>
        </div>
      </div>
    </footer>
  </div>
</Base>

<style>
  .page {
    --hero: #16161A; --hero-2: #0D0D10; --hero-tx: #F4F0E8; --hero-mut: #A7A7AD; --hero-fnt: #6B6B72;
    --hero-line: rgba(244, 240, 232, .16); --ember-lit: #D5743E;
  }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 48px; }

  /* ═══════════ BOLD PORTRAIT COVER ═══════════ */
  .hero { position: relative; min-height: 100vh; background: var(--paper); color: var(--ink);
    display: grid; grid-template-columns: 1fr clamp(320px, 44vw, 660px); overflow: hidden; }

  .hero-top { position: absolute; top: 0; left: 0; right: 0; z-index: 8; display: flex; align-items: center;
    justify-content: space-between; padding: 28px clamp(24px, 4vw, 56px); }
  .mark { font-family: var(--serif); font-weight: 600; font-size: 28px; letter-spacing: -.012em; color: var(--ink); }
  .mark .pt { color: var(--ember); }
  .hero-nav { display: flex; gap: 30px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); }
  .hero-nav a:hover { color: var(--ink); }

  .hero-type { position: relative; z-index: 5; align-self: end;
    padding: clamp(120px, 16vh, 180px) 24px clamp(56px, 8vw, 104px) clamp(24px, 4vw, 56px); }
  .idx { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px;
    background: var(--ember); color: var(--paper); font-family: var(--serif); font-weight: 700; font-size: 21px; margin-bottom: 26px; }
  .ghost { position: absolute; z-index: -1; left: -1.5%; bottom: clamp(40px, 7vw, 92px); font-family: var(--serif); font-weight: 700;
    font-size: clamp(8rem, 30vw, 460px); line-height: .72; color: var(--cream); pointer-events: none; user-select: none; white-space: nowrap; }
  .name { font-family: var(--serif); font-weight: 700; font-size: clamp(4rem, 13vw, 200px); line-height: .82;
    letter-spacing: -.03em; color: var(--ink); font-optical-sizing: auto; font-variation-settings: "SOFT" 0, "WONK" 0; }
  .type-foot { display: flex; align-items: center; gap: 28px; margin-top: 26px; flex-wrap: wrap; }
  .sub { font-size: 13px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-soft); }
  .scrollcue { display: inline-flex; align-items: center; gap: 9px; font-size: 11px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .scrollcue .dn { color: var(--ember); font-size: 14px; }

  .hero-portrait { position: relative; z-index: 1; }
  .hero-portrait .ph { position: absolute; inset: 0; border: 0; border-left: 1px solid var(--stone);
    background: var(--cream); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hero-portrait .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.04); }
  .hero-portrait .ph .tag { margin: 0; border: 0; background: none; font-family: var(--serif); font-style: italic;
    font-weight: 400; font-size: clamp(16px, 1.8vw, 22px); letter-spacing: 0; text-transform: none; color: var(--ink-soft); }

  .side { position: absolute; left: clamp(16px, 2vw, 22px); top: 50%; transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl; z-index: 6; font-size: 11px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; color: var(--ink-soft); }
  .baseline { position: absolute; left: 0; bottom: 0; z-index: 7; height: 3px; width: 100%; transform-origin: left;
    background: linear-gradient(90deg, var(--ember) 0%, var(--ember) 30%, var(--stone) 30%, var(--stone) 100%); }

  :global(.anim) .hero-portrait .ph { filter: blur(20px); transform: scale(1.06); opacity: 0;
    transition: filter 1.6s cubic-bezier(.22, .61, .25, 1), transform 1.6s cubic-bezier(.22, .61, .25, 1), opacity 1.2s; }
  :global(.anim) .hero-portrait .ph.in { filter: none; transform: none; opacity: 1; }
  :global(.anim) .baseline { transform: scaleX(0); animation: growx 1.3s cubic-bezier(.3, .7, .2, 1) forwards .7s; }
  @keyframes growx { to { transform: scaleX(1); } }

  /* ═══════════ WARM-LIGHT EDITORIAL BODY ═══════════ */
  .breathe { padding: 78px 0 4px; display: flex; align-items: baseline; gap: 22px; }
  .breathe .k { font-family: var(--serif); font-style: italic; font-size: clamp(1.3rem, 3vw, 30px); color: var(--ink); max-width: 24ch; }
  .breathe .m { margin-left: auto; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); white-space: nowrap; }
  .ph { position: relative; overflow: hidden; background: repeating-linear-gradient(135deg, #EFEAE0 0 22px, #F4F0E8 22px 44px); border: 1px solid var(--stone); display: flex; align-items: flex-end; }
  .ph .tag { margin: 14px; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); background: var(--paper); border: 1px solid var(--stone); padding: 5px 9px; }
  .spread { display: grid; gap: 56px; align-items: center; padding: 88px 0; position: relative; }
  .spread.a { grid-template-columns: 1fr 1.2fr; }
  .spread.b { grid-template-columns: 1.2fr 1fr; }
  .spread.b .txt { order: 2; }
  .snum { position: absolute; top: 44px; font-family: var(--serif); font-weight: 500; font-size: clamp(90px, 13vw, 200px); line-height: .7; color: var(--cream); z-index: 0; pointer-events: none; }
  .spread.a .snum { left: -8px; }
  .spread.b .snum { right: -8px; }
  .txt { position: relative; z-index: 1; }
  .spread .eyebrow { margin-bottom: 18px; display: inline-flex; align-items: center; gap: 10px; }
  .spread .eyebrow .tk { width: 8px; height: 8px; background: var(--ember); }
  .spread h2 { font-size: clamp(2rem, 4.4vw, 54px); max-width: 14ch; }
  .spread .felt { font-family: var(--serif); font-style: italic; font-size: 23px; color: var(--ink-soft); margin: 18px 0 0; max-width: 34ch; }
  .spread .go { display: inline-block; margin-top: 26px; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; border-bottom: 2px solid var(--ember); padding-bottom: 3px; }
  .spread .ph { aspect-ratio: 4/5; min-height: 440px; }
  .spread .ph.wide { aspect-ratio: 16/10; min-height: 360px; }
  .gal { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; }
  .gal .ph { min-height: 0; }
  .gal .ph:first-child { grid-row: span 2; }

  .band { background: var(--hero); color: var(--hero-tx); padding: 104px 0; }
  .band .q { max-width: 960px; margin: 0 auto; text-align: center; }
  .band .q p { font-family: var(--serif); font-size: clamp(2rem, 4.4vw, 50px); line-height: 1.16; font-weight: 500; letter-spacing: -.01em; }
  .band .q p .e { color: var(--ember-lit); font-style: italic; }
  .band .q .by { margin-top: 24px; font-size: 12px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--hero-mut); }

  footer { padding: 100px 0 72px; }
  footer .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: end; }
  footer .eyebrow { margin-bottom: 20px; }
  footer h2 { font-size: clamp(2.4rem, 6vw, 58px); }
  footer .mailto { display: inline-block; margin-top: 22px; font-family: var(--serif); font-size: 30px; border-bottom: 1px solid var(--ink); padding-bottom: 4px; }
  footer .col .k { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); }
  footer .col .v { margin-top: 6px; }
  footer .cols { display: flex; gap: 52px; }
  footer .colo { margin-top: 60px; padding-top: 26px; border-top: 1px solid var(--stone); display: flex; justify-content: space-between; align-items: center; font-size: 12px; color: var(--ink-soft); }
  footer .colo .sign { font-family: var(--serif); font-size: 24px; color: var(--ink); letter-spacing: -.012em; }
  footer .colo .sign .pt { color: var(--ember); }

  @media (max-width: 960px) {
    .wrap { padding-left: 24px; padding-right: 24px; }
    .spread.a, .spread.b { grid-template-columns: 1fr; gap: 36px; padding: 60px 0; }
    .spread.b .txt { order: 0; }
    footer .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-top { flex-wrap: wrap; row-gap: 12px; padding: 16px 24px; }
    .hero-nav { width: 100%; gap: 16px 18px; flex-wrap: wrap; font-size: 11px; }
    .hero-type { order: 1; align-self: start; padding: 112px 24px 40px; }
    .hero-portrait { order: 2; min-height: 64vh; border-top: 1px solid var(--stone); }
    .hero-portrait .ph { border-left: 0; }
    .name { font-size: clamp(3.4rem, 19vw, 104px); }
    .ghost, .side { display: none; }
  }
</style>

<script is:inline>
  (function () {
    if (!document.documentElement.classList.contains('anim')) return;
    var type = document.querySelector('.hero-type'),
        ghost = document.querySelector('.ghost'),
        portrait = document.querySelector('.hero-portrait .ph'),
        t = false;
    window.addEventListener('scroll', function () {
      if (t) return; t = true;
      requestAnimationFrame(function () {
        var y = window.scrollY || 0, vh = window.innerHeight;
        if (y < vh) {
          if (type) { type.style.transform = 'translateY(' + (y * 0.12) + 'px)'; type.style.opacity = String(Math.max(0, 1 - y / (vh * 0.85))); }
          if (ghost) ghost.style.transform = 'translateY(' + (y * -0.05) + 'px)';
          if (portrait) portrait.style.transform = 'scale(' + (1 + (y / vh) * 0.05) + ')';
        }
        t = false;
      });
    }, { passive: true });
  })();
</script>
