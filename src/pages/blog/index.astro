---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const fmt = (s: string) =>
  new Date(s).toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base
  title="Journal — kagiso.me"
  description="Decisions, incidents, and the ones I got wrong first — real operational write-ups from a self-hosted lab."
  bg="var(--paper)"
  color="var(--ink)"
>
  <SiteNav variant="light" />
  <div class="wrap">
    <header class="mast">
      <div class="eyebrow"><span class="tk"></span>The Lab · Writing</div>
      <h1>Journal.</h1>
      <p class="dek">Decisions, incidents, and the ones I got wrong first.</p>
    </header>

    <ol class="list">
      {posts.map((post) => (
        <li class="item reveal">
          <a href={`/blog/${post.id}`}>
            <div class="meta"><span class="date">{fmt(post.data.date)}</span>{post.data.adr && <span class="adr">{post.data.adr}</span>}</div>
            <h2>{post.data.title}</h2>
            <p class="sum">{post.data.summary}</p>
            {post.data.tags && <div class="tags">{post.data.tags.map((t) => <span>{t}</span>)}</div>}
          </a>
        </li>
      ))}
    </ol>
  </div>
  <SiteFooter variant="light" maxWidth={880} note={'© 2026 · kagiso.me · <a href="/rss.xml">RSS</a> · written in the open'} />
</Base>

<style>
  .wrap { max-width: 880px; margin: 0 auto; padding: 0 44px; }
  .mast { padding: 90px 0 40px; border-bottom: 1px solid var(--ink); }
  .eyebrow { display: inline-flex; align-items: center; gap: 11px; font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-soft); }
  .eyebrow .tk { width: 9px; height: 9px; background: var(--ember); }
  .mast h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(3rem, 9vw, 116px); line-height: .92; letter-spacing: -.02em; margin: 24px 0 0; }
  .mast .dek { font-family: var(--serif); font-style: italic; font-size: clamp(1.2rem, 2.6vw, 28px); color: var(--ink-soft); margin: 16px 0 0; }

  .list { list-style: none; margin: 0; padding: 0; }
  .item { border-bottom: 1px solid var(--stone); }
  .item a { display: block; padding: 40px 0; }
  .item .meta { display: flex; gap: 16px; align-items: baseline; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); }
  .item .adr { color: var(--ember); }
  .item h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(1.7rem, 3.6vw, 40px); line-height: 1.04; margin: 14px 0 0; max-width: 22ch; }
  .item:hover h2 { color: var(--ember); }
  .item .sum { color: var(--ink-soft); margin: 14px 0 0; max-width: 62ch; }
  .item .tags { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .item .tags span { font-size: 10.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); border: 1px solid var(--stone); padding: 4px 9px; }
  @media (max-width: 860px) { .wrap { padding-left: 22px; padding-right: 22px; } }
</style>
