---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work'))
    .filter((s) => !s.data.draft)
    .sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const hasFilm = d.frames.some((f) => f.type === 'film');
const hasStill = d.frames.some((f) => f.type === 'still');
const medium = d.mediumLabel ?? (hasFilm && hasStill ? 'Stills & Film' : hasFilm ? 'Film' : 'Stills');
const credit = d.creditNote ?? (hasFilm ? 'Shot, cut & graded by hand' : 'Every frame shot & owned');
const playIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
let still = 0;
---
<Base
  title={`${d.title} — Work — kagiso.me`}
  description={d.statement}
  bg="var(--paper)"
  color="var(--ink)"
>
  <SiteNav active="work" variant="light" />

  <div class="work-room">
    <div class="wrap">
      <a class="back" href="/stills-and-motion"><span class="arw">←</span> Stills &amp; Motion</a>
      <header class="open">
        <div class="mghost" aria-hidden="true">{d.number}</div>
        <div class="eyebrow kick" data-rise style="--d:.05s"><span class="tk"></span>No. {d.number} — {medium}</div>
        <h1 data-rise style="--d:.12s">{d.title}</h1>
        <div class="meta" data-rise style="--d:.2s">{[d.years, d.place, d.role].filter(Boolean).join(' · ')}</div>
        <p class="statement" data-rise style="--d:.3s">{d.statement}</p>
        <div class="mbase"></div>
      </header>
    </div>

    <div class="edit">
      {d.frames.map((f) => {
        const n = f.type === 'still' ? String(++still).padStart(2, '0') : null;
        const num = d.showFrameNumbers && n ? <span class="fnum">{n}</span> : null;
        if (f.span === 'pair') {
          return (
            <figure class="frame pair reveal">
              <div class="two">
                <div><div class="ph dev">{f.image ? <img src={f.image} alt={f.alt} loading="lazy" decoding="async" /> : <span class="tag">{f.tag ?? f.alt}</span>}</div></div>
                <div><div class="ph dev">{f.imageB ? <img src={f.imageB} alt={f.altB ?? ''} loading="lazy" decoding="async" /> : <span class="tag">{f.tagB ?? f.altB}</span>}</div></div>
              </div>
              {(f.caption || f.captionB) && <figcaption>{num}{[f.caption, f.captionB].filter(Boolean).join('  ·  ')}</figcaption>}
            </figure>
          );
        }
        const sideClass = f.span === 'offset' || f.span === 'tall' ? ` ${f.side}` : '';
        const style = f.span === 'full' && f.minvh ? `min-height:${f.minvh}vh` : undefined;
        return (
          <figure class={`frame ${f.span}${sideClass}`}>
            <div class="reveal">
              {f.type === 'film' ? (
                <button class="ph film dev" data-video={f.video ?? ''} data-title={d.title} aria-label={`Play ${d.title}`}>
                  {f.image ? <img src={f.image} alt={f.alt} loading="lazy" decoding="async" /> : <span class="tag">{f.tag ?? f.alt}</span>}
                  <span class="play" aria-hidden="true" set:html={playIcon}></span>
                  {f.runtime && <span class="rt">{f.runtime}</span>}
                </button>
              ) : (
                <div class="ph dev" style={style}>{f.image ? <img src={f.image} alt={f.alt} loading="lazy" decoding="async" /> : <span class="tag">{f.tag ?? f.alt}</span>}</div>
              )}
              {f.caption && <figcaption>{num}{f.caption}</figcaption>}
            </div>
          </figure>
        );
      })}
    </div>

    <div class="wrap">
      <div class="colophon reveal">
        <div class="cred">{[d.role, d.years, d.place].filter(Boolean).join(' · ')}</div>
        {d.gear && <div class="gear">{d.gear}</div>}
        <div class="note">{credit}</div>
        <div class="sign">kagiso<span class="pt">.</span></div>
      </div>
    </div>

    {(prev || next) && (
      <nav class="pn">
        <div class="pn-in">
          {prev ? (
            <a class="pn-l" href={`/stills-and-motion/${prev.id}`}>
              <span class="dir"><span class="arw">←</span> Previous</span>
              <span class="t"><span class="no">No. {prev.data.number}</span> {prev.data.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="pn-r" href={`/stills-and-motion/${next.id}`}>
              <span class="dir">Next <span class="arw">→</span></span>
              <span class="t"><span class="no">No. {next.data.number}</span> {next.data.title}</span>
            </a>
          ) : <span></span>}
        </div>
      </nav>
    )}
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" id="lbClose" aria-label="Close">✕</button>
    <div class="lb-frame" id="lbFrame"></div>
  </div>

  <SiteFooter variant="light" maxWidth={1280} note={'© 2026 · kagiso.me · <a href="/stills-and-motion">Stills &amp; Motion</a> · every frame shot &amp; owned'} />
</Base>

<script is:inline>
  (function () {
    var lb = document.getElementById('lightbox');
    var frame = document.getElementById('lbFrame');
    var closeBtn = document.getElementById('lbClose');
    if (!lb || !frame || !closeBtn) return;
    var lastFocus = null;
    function open(url, title) {
      if (!url) return;
      var embed = url, m;
      if ((m = url.match(/vimeo\.com\/(\d+)/))) embed = 'https://player.vimeo.com/video/' + m[1];
      else if ((m = url.match(/youtu\.be\/([\w-]+)/))) embed = 'https://www.youtube.com/embed/' + m[1];
      else if ((m = url.match(/youtube\.com\/watch\?v=([\w-]+)/))) embed = 'https://www.youtube.com/embed/' + m[1];
      frame.innerHTML = '<iframe src="' + embed + '" title="' + (title || 'Film') + '" allow="autoplay; fullscreen" allowfullscreen></iframe>';
      lb.hidden = false;
      lastFocus = document.activeElement;
      closeBtn.focus();
      document.addEventListener('keydown', onKey);
    }
    function close() {
      lb.hidden = true;
      frame.innerHTML = '';
      document.removeEventListener('keydown', onKey);
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    function onKey(e) {
      if (e.key === 'Escape') close();
      if (e.key === 'Tab') { e.preventDefault(); closeBtn.focus(); }
    }
    closeBtn.addEventListener('click', close);
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.querySelectorAll('.ph.film').forEach(function (b) {
      b.addEventListener('click', function () { open(b.getAttribute('data-video'), b.getAttribute('data-title')); });
    });
  })();
</script>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .back { display: inline-block; margin: 36px 0 0; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--w-mut); }
  .back .arw { color: var(--ember); }
  .back:hover { color: var(--w-ink); }

  .open { position: relative; padding: 28px 0 40px; max-width: 920px; }
  .kick { display: inline-flex; align-items: center; gap: 11px; margin-bottom: 20px; color: var(--w-mut); }
  .kick .tk { width: 9px; height: 9px; background: var(--ember); }
  .open h1 { font-family: var(--serif); font-weight: 440; font-size: clamp(3.25rem, 9vw, 132px); line-height: .9; letter-spacing: -.025em; color: var(--w-ink); }
  .open .meta { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--w-mut); margin-top: 22px; }
  .open .statement { font-family: var(--serif); font-style: italic; font-size: clamp(1.25rem, 2.6vw, 30px); line-height: 1.3; color: var(--w-ink); margin: 22px 0 0; max-width: 34ch; }
  .open .kick, .open h1, .open .meta, .open .statement, .open .mbase { position: relative; z-index: 1; }
  .mghost { position: absolute; z-index: 0; top: -20px; right: -1%; font-family: var(--serif); font-weight: 400;
    font-size: clamp(150px, 26vw, 320px); line-height: .72; color: var(--cream); pointer-events: none; user-select: none; }
  .mbase { height: 3px; width: 100%; margin-top: 40px; transform-origin: left;
    background: linear-gradient(90deg, var(--ember) 0, var(--ember) 30%, var(--w-line) 30%, var(--w-line) 100%); }
  :global(.anim) .mbase { transform: scaleX(0); animation: growx 1.3s cubic-bezier(.3, .7, .2, 1) forwards .5s; }
  @keyframes growx { to { transform: scaleX(1); } }

  /* The edit */
  .edit { display: flex; flex-direction: column; gap: clamp(72px, 9vw, 128px); padding: clamp(48px, 6vw, 88px) 0 0; }
  .frame { margin: 0; }
  .frame.full + .frame, .frame + .frame.full { margin-top: clamp(24px, 3vw, 48px); }

  .ph { position: relative; overflow: hidden; border: 1px solid var(--w-line); background: var(--cream); display: flex; width: 100%; }
  .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ph .tag { position: absolute; inset: 0; margin: 0; border: 0; background: none; display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(14px, 1.6vw, 20px); letter-spacing: 0; text-transform: none; color: var(--w-faint); }

  .frame.full { width: 100vw; margin-left: calc(50% - 50vw); }
  .frame.full .ph { min-height: 72vh; max-height: 88vh; border-left: 0; border-right: 0; }
  .frame.wide { max-width: 1280px; margin-left: auto; margin-right: auto; padding: 0 var(--w-pad, 44px); }
  .frame.wide .ph { aspect-ratio: 3/2; }
  .frame.single { max-width: 680px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .frame.single .ph { aspect-ratio: 4/5; }
  .frame.offset { max-width: 1280px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .frame.offset .ph { aspect-ratio: 5/4; width: 62%; }
  .frame.offset.right .ph { margin-left: auto; }
  .frame.tall { max-width: 1280px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .frame.tall .ph { aspect-ratio: 2/3; width: 46%; }
  .frame.tall.right .ph { margin-left: auto; }
  .frame.pair { max-width: 1280px; margin: 0 auto; padding: 0 var(--w-pad, 44px); }
  .frame.pair .two { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .frame.pair .ph { aspect-ratio: 4/5; }

  figcaption { margin-top: 16px; max-width: 1280px; margin-left: auto; margin-right: auto; padding: 0 var(--w-pad, 44px);
    font-size: 13.5px; line-height: 1.5; color: var(--w-mut); }
  .frame.full figcaption { padding: 0 var(--w-pad, 44px); }
  .fnum { font-weight: 600; letter-spacing: .14em; color: var(--w-faint); margin-right: 12px; }

  /* Film */
  .ph.film { cursor: pointer; padding: 0; border-color: var(--w-line); aspect-ratio: 16/9; display: block; }
  .frame.full .ph.film { aspect-ratio: auto; min-height: clamp(52vh, 60vh, 64vh); }
  .ph.film .play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 88px; height: 88px; border-radius: 50%;
    border: 1.5px solid var(--ember); display: flex; align-items: center; justify-content: center; color: var(--ember); z-index: 3;
    background: transparent; transition: transform .3s cubic-bezier(.2, .7, .2, 1), background .3s; }
  .ph.film .play :global(svg) { width: 26px; height: 26px; margin-left: 4px; }
  .ph.film:hover .play { transform: translate(-50%, -50%) scale(1.08); background: rgba(200, 91, 51, .12); }
  .ph.film .rt { position: absolute; bottom: 12px; right: 14px; z-index: 3; font-size: 11px; font-weight: 600; letter-spacing: .14em; color: var(--cream); background: rgba(55, 52, 45, .72); padding: 4px 8px; }

  :global(.anim) .dev { filter: blur(16px); transform: scale(1.04); opacity: 0;
    transition: filter 1.3s cubic-bezier(.2, .7, .2, 1), transform 1.3s cubic-bezier(.2, .7, .2, 1), opacity 1s; }
  :global(.anim) .reveal.in .dev { filter: none; transform: none; opacity: 1; }

  /* Colophon */
  .colophon { margin-top: clamp(80px, 10vw, 140px); border-top: 1px solid var(--w-line); padding-top: 40px; text-align: center; }
  .colophon .cred { font-size: 12px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--w-mut); }
  .colophon .gear { font-size: 12px; letter-spacing: .1em; color: var(--w-faint); margin-top: 10px; }
  .colophon .note { font-family: var(--serif); font-style: italic; font-size: clamp(1.1rem, 2vw, 22px); color: var(--w-ink); margin-top: 18px; }
  .colophon .sign { font-family: var(--serif); font-size: 30px; color: var(--w-ink); margin-top: 26px; }
  .colophon .sign .pt { color: var(--ember); }

  /* Prev / next */
  .pn { border-top: 1px solid var(--w-line); margin-top: clamp(64px, 8vw, 112px); }
  .pn-in { max-width: 1280px; margin: 0 auto; padding: 40px var(--w-pad, 44px); display: flex; justify-content: space-between; gap: 24px; }
  .pn a { display: flex; flex-direction: column; gap: 10px; }
  .pn-r { text-align: right; margin-left: auto; }
  .pn .dir { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--w-mut); }
  .pn .dir .arw { color: var(--ember); }
  .pn .t { font-family: var(--serif); font-size: clamp(1.2rem, 2.4vw, 28px); color: var(--w-ink); }
  .pn .t .no { color: var(--ember); }
  .pn a:hover .t { color: var(--ember); }

  /* Lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 50; background: rgba(16, 16, 15, .97); display: flex; align-items: center; justify-content: center; padding: 5vw; }
  .lightbox[hidden] { display: none; }
  :global(.anim) .lightbox { animation: lbfade .3s ease both; }
  @keyframes lbfade { from { opacity: 0; } to { opacity: 1; } }
  .lb-frame { width: 100%; max-width: 1200px; aspect-ratio: 16/9; }
  .lb-frame :global(iframe) { width: 100%; height: 100%; border: 0; }
  .lb-close { position: absolute; top: 20px; right: 24px; width: 44px; height: 44px; border: 1px solid rgba(244, 240, 232, .3); background: transparent; color: #F4F0E8; font-size: 18px; cursor: pointer; }
  .lb-close:hover { border-color: var(--ember); color: var(--ember); }

  @media (max-width: 1023px) {
    .wrap, .frame.wide, .frame.single, .frame.offset, .frame.tall, .frame.pair, figcaption, .pn-in { --w-pad: 32px; }
    .frame.offset .ph { width: 78%; }
    .frame.tall .ph { width: 60%; }
  }
  @media (max-width: 767px) {
    .wrap, .frame.wide, .frame.single, .frame.offset, .frame.tall, .frame.pair, figcaption, .pn-in { --w-pad: 22px; }
    .open h1 { font-size: clamp(3rem, 15vw, 76px); }
    .frame.full .ph { min-height: 56vh; }
    .frame.offset .ph, .frame.tall .ph { width: 100%; }
  }
  @media (max-width: 639px) {
    .frame.pair .two { grid-template-columns: 1fr; }
  }
</style>
